{
  "servers": [
    {
      "id": "github",
      "name": "GitHub",
      "description": "Manage GitHub repositories, issues, and PRs",
      "default_url": "http://localhost:3001/mcp",
      "tools": ["create_issue", "list_repos", "create_pr"],
      "documentation": "https://github.com/modelcontextprotocol/servers/tree/main/src/github",
      "has_ui": false
    },
    {
      "id": "qr-server",
      "name": "QR Code Generator",
      "description": "Generate QR codes with custom data",
      "default_url": "http://localhost:3002/mcp",
      "tools": ["generate_qr"],
      "documentation": "https://github.com/modelcontextprotocol/ext-apps/tree/main/examples/qr-server",
      "has_ui": true
    },
    {
      "id": "notion",
      "name": "Notion",
      "description": "Access and manage Notion pages and databases",
      "default_url": "http://localhost:3003/mcp",
      "tools": ["search_pages", "create_page", "update_page"],
      "documentation": "https://github.com/modelcontextprotocol/servers/tree/main/src/notion",
      "has_ui": false
    }
  ]
}
