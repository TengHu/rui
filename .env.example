# Copy to .env and fill in real values. Never commit .env.

# --- Required ---

# E2B sandbox API key: https://e2b.dev/dashboard
E2B_API_KEY=

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Optional ---

# Connect to a pre-existing sandbox instead of creating one
# SANDBOX_ID=

WORKSPACE_DIR=/home/user/workspace
E2B_TEMPLATE_ID=general-ai-agent
PORT=5001
EVENTS_FILE_MAX_LINES=2000

# --- Google OAuth ---
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# OAUTH_REDIRECT_URI and COOKIE_SECURE are auto-detected from the request.
# Only set these if you need to override the auto-detection:
# OAUTH_REDIRECT_URI=https://example.com/api/auth/callback
# COOKIE_SECURE=true

# --- Analytics (optional) ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
